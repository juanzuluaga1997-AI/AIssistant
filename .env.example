CALENDAR_PROVIDER=apps_script
CALENDAR_BRIDGE_URL=
CALENDAR_BRIDGE_SECRET=
EVENT_TIME_ZONE=America/Bogota

# Optional future Google OAuth provider. Not needed when CALENDAR_PROVIDER=apps_script.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=
ALLOWED_GOOGLE_EMAIL=juan.zuluaga1997@gmail.com
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2026-03-11

GEMINI_API_KEY=
GEMINI_EMAIL_MODEL=gemini-2.5-flash-lite
GEMINI_EMAIL_ENABLED=false
GEMINI_EMAIL_PRIMARY_ENABLED=false
GEMINI_EMAIL_INTERPRETATION_ENABLED=false
GEMINI_EMAIL_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_EMAIL_TIMEOUT_MS=12000

GEMINI_DASHBOARD_ENABLED=false
GEMINI_DASHBOARD_MODEL=gemini-2.5-flash-lite
# Disabled by default to avoid extra latency when fallback models have limit: 0.
GEMINI_DASHBOARD_FALLBACK_CHAIN_ENABLED=false
# Saved for future use. Ignored unless GEMINI_DASHBOARD_FALLBACK_CHAIN_ENABLED=true.
GEMINI_DASHBOARD_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-pro
GEMINI_DASHBOARD_TIMEOUT_MS=12000
